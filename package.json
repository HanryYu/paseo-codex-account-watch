{
  "name": "paseo-codex-account-watch",
  "private": true,
  "version": "0.2.0",
  "description": "Host-scoped Codex account monitoring and migrations for Paseo",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build-bridge.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test *.test.ts",
    "test:daemon": "npm run build && node --import tsx integration/daemon-smoke.ts",
    "test:codex": "npm run build && node --import tsx integration/codex-account-probe.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@getpaseo/client": "0.7.0-beta.3",
    "@getpaseo/protocol": "0.7.0-beta.3",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.1",
    "prettier": "^3.6.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  }
}
